<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:padding = "0dp"
    android:orientation="vertical"
    android:clipToOutline="true"
    android:background="@drawable/dialog_background">



    <FrameLayout
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_margin="2dp"
            android:id="@+id/fln_beauty_notify_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/img_radius2"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_margin="0dp"
            tools:ignore="UseCompoundDrawables">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">
            <ImageView
                android:id="@+id/fln_beauty_notify_app_icon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_margin="8dp"
                android:padding="2dp"
                android:background="@drawable/img_radius2"
                tools:ignore="ContentDescription" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                tools:ignore="UseCompoundDrawables">

                <TextView
                    android:id="@+id/fln_beauty_notify_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFB219"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="This is title" />

                <TextView
                    android:id="@+id/fln_beauty_notify_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:singleLine="false"
                    android:scrollHorizontally="false"
                    android:textColor="#FFB219"
                    android:textSize="16sp"
                    android:layout_gravity="bottom|center_horizontal"

                    tools:text="This is body" />

            </LinearLayout>
        </LinearLayout>



            <TextView
                android:id="@+id/fln_beauty_notify_btn"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:background="@drawable/fln_beauty_notify_btn_bg"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_margin="8dp"
                android:singleLine="true"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                tools:text="This is button" />

        </LinearLayout>


    </FrameLayout>



</LinearLayout>